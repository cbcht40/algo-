{
  "name": "tradovate-copier",
  "version": "0.1.0",
  "description": "Near-instant order-replication trade copier for Tradovate (Mac-friendly, no NinjaTrader needed).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx tools/setup.ts",
    "service:install": "bash tools/service.sh install",
    "service:uninstall": "bash tools/service.sh uninstall",
    "service:status": "bash tools/service.sh status",
    "service:logs": "bash tools/service.sh logs",
    "service:restart": "bash tools/service.sh restart",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "app": "electron electron/main.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "electron": "^42.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
