{
  "name": "tradovate-copier",
  "version": "0.1.0",
  "description": "Near-instant order-replication trade copier for Tradovate (Mac-friendly, no NinjaTrader needed).",
  "author": "Let-Trade Journal",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx tools/setup.ts",
    "service:install": "bash tools/service.sh install",
    "service:uninstall": "bash tools/service.sh uninstall",
    "service:status": "bash tools/service.sh status",
    "service:logs": "bash tools/service.sh logs",
    "service:restart": "bash tools/service.sh restart",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "app": "electron electron/main.cjs",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run bundle && electron-builder --mac",
    "dist:win": "npm run bundle && electron-builder --win"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.lettradejournal.copier",
    "productName": "Let Trade Copieur",
    "artifactName": "Let-Trade-Copieur-${version}-${arch}.${ext}",
    "afterPack": "scripts/afterpack.cjs",
    "asar": false,
    "files": [
      "electron/**",
      "build/**",
      "extension/**",
      "package.json"
    ],
    "directories": { "output": "release" },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "identity": null,
      "icon": "icon.png"
    },
    "win": { "target": "nsis", "icon": "icon.png" }
  }
}
