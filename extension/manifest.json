{
  "manifest_version": 3,
  "name": "Copilink — Tradovate Copier",
  "version": "1.0.0",
  "description": "Capte automatiquement le token de ta session Tradovate et l'envoie au copieur local. Zéro copier-coller.",
  "permissions": ["webRequest", "storage", "alarms"],
  "host_permissions": [
    "https://*.tradovateapi.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Copilink",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
